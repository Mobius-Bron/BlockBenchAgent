{
  "name": "add_group",
  "title": "Add Group",
  "description": "Adds a new group with the given name and options.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "origin": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "3D vector [x, y, z]."
      },
      "rotation": {
        "$ref": "#/properties/origin"
      },
      "parent": {
        "type": "string",
        "default": "root"
      },
      "visibility": {
        "type": "boolean",
        "default": true
      },
      "autouv": {
        "type": "string",
        "enum": [
          "0",
          "1",
          "2"
        ],
        "default": "0",
        "description": "Auto UV setting. 0 = disabled, 1 = enabled, 2 = relative auto UV."
      },
      "selected": {
        "type": "boolean",
        "default": false
      },
      "shade": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "name",
      "origin",
      "rotation"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
