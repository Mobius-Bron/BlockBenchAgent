{
  "name": "add_armature_bone",
  "title": "Add Armature Bone",
  "description": "Creates a new bone and adds it to an armature or parent bone.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "parent_id": {
        "type": "string",
        "description": "UUID or name of parent armature or bone."
      },
      "name": {
        "type": "string",
        "default": "bone",
        "description": "Name for the new bone."
      },
      "origin": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Position of the bone. Defaults to [0, parent.length, 0] for child bones."
      },
      "rotation": {
        "$ref": "#/properties/origin",
        "description": "3D vector [x, y, z].",
        "default": [
          0,
          0,
          0
        ]
      },
      "length": {
        "type": "number",
        "default": 8,
        "description": "Length of the bone."
      },
      "width": {
        "type": "number",
        "default": 2,
        "description": "Width of the bone."
      },
      "connected": {
        "type": "boolean",
        "default": true,
        "description": "Whether bone is connected to parent."
      },
      "color": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7,
        "description": "Marker color index (0-7)."
      }
    },
    "required": [
      "parent_id"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
