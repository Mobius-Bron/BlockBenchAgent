{
  "name": "modify_cube",
  "title": "Modify Cube",
  "description": "Modifies the cube with the given ID. Auto UV setting: saved as an integer, where 0 means disabled, 1 means enabled, and 2 means relative auto UV (cube position affects UV)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "ID or name of the cube to modify. Defaults to selected, which could be more than one."
      },
      "name": {
        "type": "string",
        "description": "New name of the cube."
      },
      "origin": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Pivot point of the cube."
      },
      "from": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Starting point of the cube."
      },
      "to": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Ending point of the cube."
      },
      "rotation": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Rotation of the cube."
      },
      "autouv": {
        "type": "string",
        "enum": [
          "0",
          "1",
          "2"
        ],
        "description": "Auto UV setting. 0 = disabled, 1 = enabled, 2 = relative auto UV."
      },
      "uv_offset": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "UV offset for the texture."
      },
      "mirror_uv": {
        "type": "boolean",
        "description": "Whether to mirror the UVs."
      },
      "shade": {
        "type": "boolean",
        "description": "Whether to apply shading to the cube."
      },
      "inflate": {
        "type": "number",
        "description": "Inflation amount for the cube."
      },
      "color": {
        "type": "number",
        "description": "Single digit to represent a color from a palette."
      },
      "visibility": {
        "type": "boolean",
        "description": "Whether the cube is visible or not."
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
