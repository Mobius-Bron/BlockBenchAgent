{
  "name": "add_armature",
  "title": "Add Armature",
  "description": "Creates a new armature in the project. An armature is a skeletal rig used for mesh deformation.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "armature",
        "description": "Name for the new armature."
      },
      "visibility": {
        "type": "boolean",
        "default": true
      },
      "locked": {
        "type": "boolean",
        "default": false
      },
      "add_initial_bone": {
        "type": "boolean",
        "default": true,
        "description": "Whether to add an initial bone to the armature."
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
