{
  "name": "create_texture",
  "title": "Create Texture",
  "description": "Creates a new texture with the given name and size.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "width": {
        "type": "number",
        "minimum": 16,
        "maximum": 4096,
        "default": 16
      },
      "height": {
        "type": "number",
        "minimum": 16,
        "maximum": 4096,
        "default": 16
      },
      "data": {
        "type": "string",
        "description": "Path to the image file or data URL."
      },
      "group": {
        "type": "string"
      },
      "fill_color": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "RGBA [R, G, B, A]"
          },
          {
            "type": "string",
            "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$"
          },
          {
            "type": "string",
            "pattern": "^[a-z]{3,20}$"
          }
        ],
        "description": "RGBA color to fill the texture, as tuple or HEX string."
      },
      "layer_name": {
        "type": "string",
        "description": "Name of the texture layer. Required if fill_color is set."
      },
      "pbr_channel": {
        "type": "string",
        "enum": [
          "color",
          "normal",
          "height",
          "mer"
        ],
        "description": "PBR channel to use for the texture. Color, normal, height, or Metalness/Emissive/Roughness (MER) map."
      },
      "render_mode": {
        "type": "string",
        "enum": [
          "default",
          "emissive",
          "additive",
          "layered"
        ],
        "default": "default",
        "description": "Render mode for the texture. Default, emissive, additive, or layered."
      },
      "render_sides": {
        "type": "string",
        "enum": [
          "auto",
          "front",
          "double"
        ],
        "default": "auto",
        "description": "Render sides for the texture. Auto, front, or double."
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
