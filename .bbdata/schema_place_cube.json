{
  "name": "place_cube",
  "title": "Place Cube",
  "description": "Places a cube of the given size at the specified position. Texture and group are optional.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "elements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "origin": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Pivot point of the cube.",
              "default": [
                0,
                0,
                0
              ]
            },
            "from": {
              "$ref": "#/properties/elements/items/properties/origin",
              "description": "Starting point of the cube.",
              "default": [
                0,
                0,
                0
              ]
            },
            "to": {
              "$ref": "#/properties/elements/items/properties/origin",
              "description": "Ending point of the cube.",
              "default": [
                1,
                1,
                1
              ]
            },
            "rotation": {
              "$ref": "#/properties/elements/items/properties/origin",
              "description": "Rotation of the cube.",
              "default": [
                0,
                0,
                0
              ]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "description": "Array of cubes to place."
      },
      "texture": {
        "type": "string",
        "description": "Texture ID or name to apply to the cube."
      },
      "group": {
        "type": "string",
        "description": "Group/bone to which the cube belongs."
      },
      "faces": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "north",
                "south",
                "east",
                "west",
                "up",
                "down"
              ]
            },
            "description": "Array of faces to apply the texture to."
          },
          {
            "anyOf": [
              {
                "not": {}
              },
              {
                "type": "boolean"
              }
            ],
            "description": "Whether to apply the texture to all faces. Set to `true` to enable auto UV mapping."
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "face": {
                  "type": "string",
                  "enum": [
                    "north",
                    "south",
                    "east",
                    "west",
                    "up",
                    "down"
                  ],
                  "description": "Face to apply the texture to."
                },
                "uv": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "Custom UV mapping for the face."
                }
              },
              "required": [
                "face",
                "uv"
              ],
              "additionalProperties": false
            },
            "description": "Array of faces with custom UV mapping."
          }
        ],
        "default": true,
        "description": "Faces to apply the texture to. Set to `true` to enable auto UV mapping."
      }
    },
    "required": [
      "elements"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
